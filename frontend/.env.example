# ---------------------------------------------------------------------------
# 1) MAPBOX TOKEN — the only key you need to fill in.
#    Free account: https://account.mapbox.com/auth/signup/
#    Then copy the "Default public token" (starts with pk.) from
#    https://account.mapbox.com/access-tokens/ and paste it after the = sign.
# ---------------------------------------------------------------------------
VITE_MAPBOX_TOKEN=

# ---------------------------------------------------------------------------
# 2) BACKEND URL (no trailing slash)
#    Local demo (no AWS):  http://localhost:8000   <- default, started by start-demo
#    AWS deployment:       the SAM output HttpApiUrl, e.g. https://abc123.execute-api.ap-south-1.amazonaws.com
#    Empty:                dashboard shows the bundled offline snapshot
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000

# Refresh every 5 s so new attacks show up quickly during a demo.
VITE_POLL_MS=5000
VITE_EVENTS_LIMIT=200
