# ---------------------------------------------------------------------------
# No keys are required. With VITE_MAPBOX_TOKEN empty the dashboard draws the
# 3D globe with MapLibre + OpenFreeMap (free, no account).
#
# OPTIONAL: paste a Mapbox public token (starts with pk.) to use the Mapbox
# globe instead. Free account: https://account.mapbox.com/auth/signup/
# ---------------------------------------------------------------------------
VITE_MAPBOX_TOKEN=

# ---------------------------------------------------------------------------
# BACKEND URL (no trailing slash)
#    Local demo (no AWS):  http://localhost:8000   <- default, started by start-demo
#    AWS deployment:       the SAM output HttpApiUrl, e.g. https://abc123.execute-api.ap-south-1.amazonaws.com
#    Empty:                dashboard shows the bundled offline snapshot
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000

# Refresh every 5 s so new attacks show up quickly during a demo.
VITE_POLL_MS=5000
# Events per poll (the local backend serves up to 500; the AWS read API caps at 100).
VITE_EVENTS_LIMIT=500
