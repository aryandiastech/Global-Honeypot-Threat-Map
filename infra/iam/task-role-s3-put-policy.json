{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PutRawHoneypotObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_RAW_BUCKET_NAME/*"
    },
    {
      "Sid": "MultipartUploadSupport",
      "Effect": "Allow",
      "Action": ["s3:ListMultipartUploadParts", "s3:ListBucketMultipartUploads"],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_RAW_BUCKET_NAME",
        "arn:aws:s3:::REPLACE_WITH_RAW_BUCKET_NAME/*"
      ]
    }
  ]
}
